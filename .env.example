# GEMINI_API_KEY: Optional official Gemini API key (configured via Secrets panel or local .env).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Local API Gateway configuration (loopback-only by default)
WEBSESSION2API_HOST=127.0.0.1
WEBSESSION2API_PORT=8787
WEBSESSION2API_API_KEY=
WEBSESSION2API_MASTER_KEY=
WEBSESSION2API_DB_PATH=./data/websession2api.db
WEBSESSION2API_ALLOWED_EXTENSION_IDS=
WEBSESSION2API_LOG_LEVEL=info

